<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane prefHeight="654.0" prefWidth="904.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cafeteriaapp.resources.controllers.ProfileDetailsController">

    <top>
        <VBox style="-fx-background-color: #1a1a2e;" BorderPane.alignment="CENTER">
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <FontAwesomeIconView glyphName="CHEVRON_LEFT" fill="WHITE" size="18"
                                             onMouseClicked="#handleBack"
                                             style="-fx-cursor: hand;"/>
                        <Label text="Profile Details" textFill="WHITE">
                            <font><Font size="20.0"/></font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
            <BorderPane.margin><Insets top="20" left="40" right="40" bottom="20"/></BorderPane.margin>
            <content>
                <VBox spacing="16">
                    <children>

                        <!-- Info card -->
                        <VBox styleClass="order-card" spacing="16">
                            <children>
                                <Label text="Account Information"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                                <Separator/>

                                <!-- User ID -->
                                <VBox spacing="4">
                                    <children>
                                        <Label text="User ID"
                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                                        <Label fx:id="userIdLabel" text="—"
                                               style="-fx-font-size: 15px; -fx-text-fill: #1a1a2e;"/>
                                    </children>
                                </VBox>
                                <Separator/>

                                <!-- First Name -->
                                <VBox spacing="4">
                                    <children>
                                        <Label text="First Name"
                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                                        <Label fx:id="firstNameLabel" text="—"
                                               style="-fx-font-size: 15px; -fx-text-fill: #1a1a2e;"/>
                                    </children>
                                </VBox>
                                <Separator/>

                                <!-- Last Name -->
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Last Name"
                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                                        <Label fx:id="lastNameLabel" text="—"
                                               style="-fx-font-size: 15px; -fx-text-fill: #1a1a2e;"/>
                                    </children>
                                </VBox>
                                <Separator/>

                                <!-- Email -->
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Email"
                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                                        <Label fx:id="emailLabel" text="—"
                                               style="-fx-font-size: 15px; -fx-text-fill: #1a1a2e;"/>
                                    </children>
                                </VBox>
                                <Separator/>

                                <!-- Password -->
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Password"
                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                                        <Label text="••••••••••••"
                                               style="-fx-font-size: 15px; -fx-text-fill: #1a1a2e;"/>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                        <!-- Change Password card -->
                        <VBox styleClass="order-card" spacing="14">
                            <children>
                                <Label text="Change Password"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                                <Separator/>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Current Password"
                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                                        <PasswordField fx:id="currentPasswordField"
                                                       promptText="Enter current password"
                                                       style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #e0e0e0; -fx-padding: 8 10 8 10;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="New Password"
                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                                        <PasswordField fx:id="newPasswordField"
                                                       promptText="Enter new password"
                                                       style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #e0e0e0; -fx-padding: 8 10 8 10;"/>
                                    </children>
                                </VBox>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Confirm New Password"
                                               style="-fx-font-size: 12px; -fx-text-fill: #888888;"/>
                                        <PasswordField fx:id="confirmPasswordField"
                                                       promptText="Confirm new password"
                                                       style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #e0e0e0; -fx-padding: 8 10 8 10;"/>
                                    </children>
                                </VBox>
                                <Label fx:id="passwordFeedbackLabel" text=""
                                       style="-fx-font-size: 12px;"/>
                                <Button text="Update Password" onAction="#handleChangePassword"
                                        maxWidth="Infinity" styleClass="place-order-btn"/>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>