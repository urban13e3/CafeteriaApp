<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane prefHeight="654.0" prefWidth="904.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cafeteriaapp.resources.controllers.WalletController">

    <top>
        <VBox style="-fx-background-color: #1a1a2e;" BorderPane.alignment="CENTER">
            <padding><Insets top="24" bottom="30" left="24" right="24"/></padding>
            <children>
                <Label text="Wallet" textFill="WHITE"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <VBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 16; -fx-padding: 20;">
                    <VBox.margin><Insets top="16"/></VBox.margin>
                    <children>
                        <Label text="Wallet Balance" textFill="WHITE"
                               style="-fx-font-size: 13px; -fx-opacity: 0.8;"/>
                        <Label fx:id="balanceLabel" text="₦0.00" textFill="WHITE"
                               style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

                        <HBox spacing="30" alignment="CENTER">
                            <VBox.margin><Insets top="10"/></VBox.margin>
                            <children>
                                <VBox alignment="CENTER" spacing="6"
                                      onMouseClicked="#handleAddFunds"
                                      style="-fx-cursor: hand;">
                                    <children>
                                        <VBox alignment="CENTER"
                                              style="-fx-background-color: white; -fx-background-radius: 50; -fx-min-width: 46; -fx-min-height: 46;">
                                            <children>
                                                <FontAwesomeIconView glyphName="PLUS" size="18" fill="#1a1a2e"/>
                                            </children>
                                        </VBox>
                                        <Label text="Fund Wallet" textFill="WHITE"
                                               style="-fx-font-size: 12px;"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
            <BorderPane.margin><Insets top="16" left="24" right="24" bottom="10"/></BorderPane.margin>
            <content>
                <VBox spacing="12">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Recent Transactions"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            </children>
                        </HBox>
                        <Separator/>
                        <VBox fx:id="transactionsContainer" spacing="10"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>