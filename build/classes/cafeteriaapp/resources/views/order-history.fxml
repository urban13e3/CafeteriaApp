<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="654.0" prefWidth="904.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cafeteriaapp.resources.controllers.OrderHistoryController">

    <top>
        <VBox style="-fx-background-color: #1a1a2e;" BorderPane.alignment="CENTER">
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
            <children>
                <Label text="Order History" textFill="WHITE">
                    <font><Font size="24.0"/></font>
                </Label>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
            <BorderPane.margin><Insets top="10" left="20" right="20" bottom="10"/></BorderPane.margin>
            <content>
                <VBox fx:id="historyContainer" spacing="12">
                    <padding><Insets top="10" bottom="10"/></padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>