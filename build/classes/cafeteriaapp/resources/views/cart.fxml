<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="654.0" prefWidth="904.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cafeteriaapp.resources.controllers.CartController">

    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #1a1a2e;" BorderPane.alignment="CENTER">
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
            <children>
                <Label text="My Cart" textFill="WHITE">
                    <font><Font size="24.0"/></font>
                </Label>
            </children>
        </VBox>
    </top>

    <!-- Cart items list -->
    <center>
        <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
            <BorderPane.margin><Insets top="10" left="20" right="20" bottom="10"/></BorderPane.margin>
            <content>
                <VBox fx:id="cartItemsContainer" spacing="10">
                    <padding><Insets top="10" bottom="10"/></padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- Bottom summary + place order -->
    <bottom>
        <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;"
              BorderPane.alignment="CENTER">
            <padding><Insets top="16" bottom="24" left="24" right="24"/></padding>
            <children>
                <Separator/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox.margin><Insets top="12" bottom="12"/></VBox.margin>
                    <children>
                        <Label text="Total:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label fx:id="totalLabel" text="₦0.00"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"
                               HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>
                <Button fx:id="placeOrderBtn" text="Place Order"
                        maxWidth="Infinity"
                        onAction="#handlePlaceOrder"
                        styleClass="place-order-btn"/>
                <Button text="Continue Shopping"
                        maxWidth="Infinity"
                        onAction="#handleContinueShopping"
                        styleClass="secondary-btn"
                        style="-fx-margin-top: 8px;">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Button>
            </children>
        </VBox>
    </bottom>
</BorderPane>